# Copy this file to server.cfg and replace every CHANGE_ME value.
# server.cfg is ignored by git. Never commit your license key or database password.

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 32

set gamename rdr3
set sv_enforceGameBuild 1491

sv_licenseKey "CHANGE_ME"
set mysql_connection_string "mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost/CHANGE_ME_DATABASE?charset=utf8mb4"
set sv_enforceSteamAuth false

sv_hostname "CHANGE_ME"
sets sv_projectName "CHANGE_ME"
sets sv_projectDesc "CHANGE_ME"
sets locale "en-US"
sets tags "rsg,roleplay"

setr rsg_locale "en"
setr ox:locale en
setr UseTarget false

setr voice_useSendingRangeOnly false
setr voice_use3dAudio true
setr voice_defaultVoiceMode 2
setr voice_enableUi 1

# Base resources from cfx-server-data (see docs/INSTALL.md)
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager-rdr3
ensure hardcap

# Framework. ox_lib must start before rsg-core.
ensure oxmysql
ensure ox_lib
ensure weathersync
ensure rsg-core
ensure rsg-multicharacter
ensure rsg-spawn
ensure rsg-menubase
ensure ox_target
ensure [standalone]
ensure [framework]

exec resources/[standalone]/weathersync/permissions.cfg

# Permissions
add_ace group.admin command allow
add_ace resource.rsg-core command allow

add_ace rsgcore.god command allow
add_ace rsgcore.headadmin command allow
add_ace rsgcore.developer command allow
add_ace rsgcore.admin command allow
add_ace rsgcore.mod command allow
add_ace rsgcore.helper command allow

add_principal rsgcore.god group.admin
add_principal rsgcore.god rsgcore.headadmin
add_principal rsgcore.headadmin rsgcore.developer
add_principal rsgcore.developer rsgcore.admin
add_principal rsgcore.admin rsgcore.mod
add_principal rsgcore.mod rsgcore.helper

add_ace resource.ox_lib command.add_ace allow
add_ace resource.ox_lib command.remove_ace allow
add_ace resource.ox_lib command.add_principal allow
add_ace resource.ox_lib command.remove_principal allow

# Give yourself owner access: replace the x's with your license identifier, then remove the #
#add_principal identifier.license:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx rsgcore.god
